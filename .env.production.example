# Modelo de variáveis de ambiente para produção (VPS).
#
# Copia para .env.production e preenche os valores reais — esse ficheiro
# NUNCA é commitado (ver .gitignore). É lido por docker-compose.prod.yml.
#
#   cp .env.production.example .env.production

# --- Servidor ---
NODE_ENV=production
PORT=3333

# --- Base de Dados PostgreSQL ---
# DB_HOST tem de ser "postgres" (nome do serviço no docker-compose.prod.yml,
# resolvido pela rede interna do Docker) — nunca "localhost" em produção.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=kuava_pos
DB_USER=kuava
# Gera uma senha forte e única, ex.: openssl rand -base64 24
DB_PASSWORD=GERAR_SENHA_FORTE_AQUI
DB_LOGGING=false

# --- Autenticação ---
# Obrigatório e tem de ser forte — a app recusa arrancar em produção sem
# isto (ver kuava-api/src/config/env.ts). Gera com: openssl rand -hex 32
JWT_SECRET=GERAR_SEGREDO_FORTE_AQUI
JWT_EXPIRES_IN=8h

# --- CORS ---
# O domínio real da app em produção (o Nginx serve frontend e API do mesmo
# domínio, mas mantém-se como defesa extra contra acesso direto à API).
CORS_ORIGIN=https://SEU_DOMINIO

# --- Regras de Negócio ---
IVA_RATE=0.16

# --- Assinatura da plataforma (fatura pro-forma, sem gateway de pagamento) ---
# Mostrados na página "Assinatura" a qualquer cliente que escolha um plano,
# são os dados para onde ele transfere manualmente (ver deploy/README.md).
KUAVA_BANK_NAME=PREENCHER_NOME_DO_BANCO
KUAVA_BANK_ACCOUNT_HOLDER=PREENCHER_TITULAR_DA_CONTA
KUAVA_BANK_NIB=PREENCHER_NIB
KUAVA_MONTHLY_PRICE_MZN=1299
KUAVA_ANNUAL_PRICE_MZN=12990

# --- Frontend (build-time, ver kuava-web/Dockerfile) ---
# "/api" porque o Nginx serve o frontend e faz proxy de /api no mesmo
# domínio — assim o browser nunca faz pedidos cross-origin.
VITE_API_BASE_URL=/api

# --- Nginx / TLS (ver deploy/README.md) ---
DOMAIN=SEU_DOMINIO

# --- Email (SMTP) ---
# Avisa o cliente quando confirmas um pagamento no painel de superadmin.
# Deixa SMTP_HOST vazio para desativar: a app corre na mesma e o aviso
# fica só no log, a confirmação do pagamento nunca depende do email.
# Usa uma caixa dedicada do teu dominio (ex.: nao-responder@...) e uma
# senha de aplicacao, nunca a senha principal da conta.
# Valores da Hostinger, onde esta o correio do dominio.
#
# 587 com STARTTLS e nao 465 com SSL por uma razao concreta: o Hetzner
# (onde este VPS corre) bloqueia as portas 25 e 465 a saida por omissao,
# para travar spam, e so as desbloqueia a pedido depois de um mes de conta
# paga. A 587 fica sempre aberta. Com 587, SMTP_SECURE tem de ser false:
# a ligacao comeca em claro e sobe para TLS por STARTTLS, que o nodemailer
# negoceia sozinho -- a senha nunca viaja em claro.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
# O utilizador e o endereco completo da caixa.
SMTP_USER=notificacoes@vektramz.com
# Senha da caixa (ou senha de aplicacao, se a caixa tiver 2FA). Este
# ficheiro e so o modelo: a senha a serio vai para .env.production, que
# nunca e commitado.
SMTP_PASSWORD=
SMTP_FROM=Kuava POS <notificacoes@vektramz.com>
# Para onde vao as respostas dos clientes a um email automatico. A caixa
# de SMTP_FROM nao e lida por ninguem, esta e.
SMTP_REPLY_TO=suporte@vektramz.com

# De quantas em quantas horas se procuram trials a terminar (avisos a 7, 3
# e 1 dia do fim, mais um quando expira; ver services/trialReminderService.ts).
# 0 desliga.
TRIAL_REMINDER_INTERVAL_HOURS=6

# Endereco publico do frontend, usado nos links dentro dos emails.
APP_URL=https://SEU_DOMINIO

# --- Backup do Postgres (ver deploy/README.md, secção "Backup do Postgres") ---
# Pasta no VPS onde os backups ficam guardados (fora do repositório de
# propósito). Cria-a com permissões adequadas antes do primeiro backup, ex.:
#   sudo mkdir -p /var/backups/kuava-postgres && sudo chown $USER /var/backups/kuava-postgres
BACKUP_DIR=/var/backups/kuava-postgres
# Quantos dias de backups LOCAIS manter (os mais antigos são apagados
# automaticamente a cada corrida do script) — o envio externo abaixo, se
# ativado, nunca é apagado por este script.
BACKUP_RETENTION_DAYS=14

# Envio externo opcional para um bucket S3-compatível (AWS S3, Backblaze B2,
# etc.) — deixa BACKUP_S3_BUCKET vazio para desativar e manter só backups
# locais. Se ativares, usa credenciais com permissão APENAS de escrita
# (PutObject), nunca de apagar (DeleteObject) — assim, mesmo que o VPS seja
# comprometido, quem lá entrar não consegue apagar os teus backups já
# enviados, só criar novos.
BACKUP_S3_BUCKET=
# Só necessário para fornecedores S3-compatíveis que não sejam a AWS (ex.
# Backblaze B2: https://s3.REGIAO.backblazeb2.com). Deixa vazio para AWS S3.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=kuava-postgres
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
