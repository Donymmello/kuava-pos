# Imagem de desenvolvimento do kuava-web: instala as dependências e corre o
# servidor Vite com hot-reload. O código-fonte é montado como bind mount
# pelo docker-compose.yml — esta imagem só trata das dependências.
FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install

EXPOSE 5173

CMD ["npm", "run", "dev"]
