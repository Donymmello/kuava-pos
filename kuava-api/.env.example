# Servidor
PORT=3333
NODE_ENV=development

# Base de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kuava_pos
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=false

# Autenticação
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=8h

# CORS
CORS_ORIGIN=http://localhost:5173

# Regras de Negócio
IVA_RATE=0.16

# Assinatura da plataforma (fatura pro-forma, sem gateway de pagamento)
KUAVA_BANK_NAME=Nome do Banco
KUAVA_BANK_ACCOUNT_HOLDER=Nome do titular da conta
KUAVA_BANK_NIB=0000000000000000000
KUAVA_MONTHLY_PRICE_MZN=1199
KUAVA_ANNUAL_PRICE_MZN=11990
