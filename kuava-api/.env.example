# Servidor
PORT=3333
NODE_ENV=development

# Base de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kuava_pos
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=false

# Autenticação
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=8h

# CORS
CORS_ORIGIN=http://localhost:5173

# Regras de Negócio
IVA_RATE=0.16

# Assinatura da plataforma (fatura pro-forma, sem gateway de pagamento)
KUAVA_BANK_NAME=Nome do Banco
KUAVA_BANK_ACCOUNT_HOLDER=Nome do titular da conta
KUAVA_BANK_NIB=0000000000000000000
KUAVA_MONTHLY_PRICE_MZN=1299
KUAVA_ANNUAL_PRICE_MZN=12990

# Email (SMTP) — opcional
# Sem SMTP_HOST o envio fica desligado e a app corre na mesma; os avisos
# ao cliente (ex.: pagamento confirmado) são apenas registados no log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Kuava POS <notificacoes@vektramz.com>
# Para onde vão as respostas dos clientes a um email automático.
SMTP_REPLY_TO=suporte@vektramz.com

# De quantas em quantas horas se procuram trials a terminar (avisos a 7, 3
# e 1 dia do fim, mais um no proprio dia em que expira). 0 desliga o agendador.
TRIAL_REMINDER_INTERVAL_HOURS=6

# Endereço público do frontend, usado nos links dentro dos emails.
APP_URL=http://localhost:5173
