# Dependências (kuava-api/ e kuava-web/, e qualquer node_modules aninhado)
node_modules/

# Builds de produção
dist/
build/

# Variáveis de ambiente — nunca committar segredos reais.
# Os .env.example ficam versionados como modelo.
.env
.env.*
!.env.example
!.env.production.example

# Deploy: certificados TLS e o ficheiro de config do Nginx que cada VPS
# gere à mão (aponta para o domínio real desse servidor) — nunca segredos
# nem estado específico de uma máquina, só os .example ficam versionados.
deploy/certbot/
deploy/nginx/active.conf

# Dumps de backup do Postgres — nunca devem ir para o repositório, mesmo que
# alguém aponte BACKUP_DIR para dentro dele por engano (o valor por omissão,
# ver .env.production.example, já fica fora do repositório).
deploy/backup/dumps/
*.sql.gz

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript incremental build info
*.tsbuildinfo

# Cobertura de testes
coverage/
.nyc_output/

# Editores / IDEs
.vscode/
.idea/
*.swp
*.swo

# Ficheiros do sistema operativo
.DS_Store
Thumbs.db
Desktop.ini

# Diversos
*.pid
